# Copy to config/.env and fill in. Never commit config/.env.
# Workspace root can be overridden with BTC_PUZZLE_LAB_HOME=/path/to/lab

# --- External solvers (production toolchain) ---
# Preferred: btc-puzzle-lab engines install
#   → builds keyhunt + kangaroo into <workspace>/bin/
#   → writes config/engines.env (auto-loaded)
# Manual overrides still win when exported:
# KEYHUNT_PATH=/path/to/keyhunt
# BITCRACK_PATH=/path/to/cuBitCrack
# KANGAROO_PATH=/path/to/kangaroo
# RCKANGAROO_PATH=/path/to/RCKangaroo
# BitCrack / RCKangaroo remain manual (CUDA / upstream packaging).

# --- Auto-transfer (off by default; dry-run by default) ---
AUTO_TRANSFER_ENABLED=false
AUTO_TRANSFER_DRY_RUN=true
AUTO_TRANSFER_DEST_ADDR=
# Required only when AUTO_TRANSFER_DRY_RUN=false:
# AUTO_TRANSFER_LIVE_CONFIRM=I_UNDERSTAND_THIS_BROADCASTS_REAL_BTC

AUTO_TRANSFER_MIN_BALANCE_SATS=5000
AUTO_TRANSFER_MIN_SEND_SATS=546
AUTO_TRANSFER_DEFAULT_FEE_RATE=15
AUTO_TRANSFER_MAX_FEE_RATE=250

# Fee selection: economy | normal | priority (maps to block-target estimates).
AUTO_TRANSFER_FEE_STRATEGY=normal
AUTO_TRANSFER_FEE_TARGET_BLOCKS=2

# Signal replace-by-fee on sweep inputs (sequence 0xfffffffd).
AUTO_TRANSFER_RBF=true

# Spend only confirmed UTXOs (recommended). Override per-run with --allow-unconfirmed.
AUTO_TRANSFER_CONFIRMED_ONLY=true

# Absolute fee ceiling in sats (in addition to MAX_FEE_RATE).
AUTO_TRANSFER_MAX_FEE_SATS=100000

# Explorers used by audit/transfer (failover in code):
# - UTXO / fee: blockstream.info → mempool.space
# - broadcast: blockstream.info → mempool.space → blockcypher
# See docs/TRANSFER.md for the post-hit runbook.

# --- Hit notifications (off by default; never include private keys) ---
NOTIFY_ENABLED=false
# Generic HTTPS webhook (Discord / Slack / ntfy / custom):
# NOTIFY_WEBHOOK_URL=https://example.com/hook
# Telegram bot (optional, can combine with webhook):
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
