# Copy to config/.env and fill in. Never commit config/.env.
# Workspace root can be overridden with BTC_PUZZLE_LAB_HOME=/path/to/lab

# --- External solvers (production toolchain) ---
# Preferred: btc-puzzle-lab engines install
#   → builds keyhunt + kangaroo into <workspace>/bin/
#   → writes config/engines.env (auto-loaded)
# Manual overrides still win when exported:
# KEYHUNT_PATH=/path/to/keyhunt
# BITCRACK_PATH=/path/to/cuBitCrack
# KANGAROO_PATH=/path/to/kangaroo
# RCKANGAROO_PATH=/path/to/RCKangaroo
# BitCrack / RCKangaroo remain manual (CUDA / upstream packaging).

# --- Auto-transfer (off by default; dry-run by default) ---
AUTO_TRANSFER_ENABLED=false
AUTO_TRANSFER_DRY_RUN=true
AUTO_TRANSFER_DEST_ADDR=
# Accepts 1... (P2PKH), 3... (P2SH), bc1q... (P2WPKH/P2WSH) and bc1p... (Taproot).
# Witness versions above 1 are refused: their spending rules are undefined, so
# funds sent there are non-standard to relay and anyone-can-spend by consensus.
# Required only when AUTO_TRANSFER_DRY_RUN=false:
# AUTO_TRANSFER_LIVE_CONFIRM=I_UNDERSTAND_THIS_BROADCASTS_REAL_BTC

AUTO_TRANSFER_MIN_BALANCE_SATS=5000
AUTO_TRANSFER_MIN_SEND_SATS=546
AUTO_TRANSFER_DEFAULT_FEE_RATE=15
AUTO_TRANSFER_MAX_FEE_RATE=250

# Fee selection: economy | normal | priority (maps to block-target estimates).
AUTO_TRANSFER_FEE_STRATEGY=normal
AUTO_TRANSFER_FEE_TARGET_BLOCKS=2

# Signal replace-by-fee on sweep inputs (sequence 0xfffffffd).
AUTO_TRANSFER_RBF=true

# Spend only confirmed UTXOs (recommended). Override per-run with --allow-unconfirmed.
AUTO_TRANSFER_CONFIRMED_ONLY=true

# Absolute fee ceiling in sats (in addition to MAX_FEE_RATE).
AUTO_TRANSFER_MAX_FEE_SATS=100000

# Explorers used by audit/transfer (failover in code):
# - UTXO / fee: blockstream.info → mempool.space
# - broadcast: blockstream.info → mempool.space → blockcypher
# See docs/TRANSFER.md for the post-hit runbook.

# --- Host / engine overrides (all optional; auto derives these) -------------
# `auto` derives ENGINE / DP / THREADS from the target and the host. Set one
# here to override that decision. Precedence, highest first:
#   auto --engine / --dp / --threads  >  these  >  what auto derives
# BTC_PUZZLE_LAB_ENGINE=rckangaroo   # force one engine for every search
# BTC_PUZZLE_LAB_DP=30               # kangaroo distinguished-point bits.
#                                    # Lower fills RAM: 30 is the safe default.
# BTC_PUZZLE_LAB_THREADS=8           # solver threads (default: from host tier)

# Pretend the host is something else — useful in containers and CI, where the
# probe sees the whole node rather than the slice you were given.
# BTC_PUZZLE_LAB_CPUS=4
# BTC_PUZZLE_LAB_MEM_MB=8192
# BTC_PUZZLE_LAB_GPU=1               # or 0 to force GPU detection off

# BitCrack grid tuning. Start unset; only touch these if nvidia-smi shows the
# card under-used.
# BTC_PUZZLE_LAB_GPU_INDEX=0         # CUDA device index (-d)
# BTC_PUZZLE_LAB_BITCRACK_BLOCKS=    # -b
# BTC_PUZZLE_LAB_BITCRACK_THREADS=   # -t
# BTC_PUZZLE_LAB_BITCRACK_POINTS=    # -p
# BTC_PUZZLE_LAB_BITCRACK_CHUNK=     # keys per invocation
# BTC_PUZZLE_LAB_BITCRACK_RANDOM=1   # sample the range instead of sweeping it

# --- Build cache and upstream pins ------------------------------------------
# Solver checkouts and build trees, shared by every workspace on this host.
# Default: ~/.cache/btc-puzzle-lab/vendor (an existing workspace vendor/ wins).
# BTC_PUZZLE_LAB_CACHE=/path/to/cache

# Each engine is cloned at a pinned commit. Override the commit to move an
# engine, or the repo to fetch through a mirror — china-bootstrap.sh sets
# BTC_PUZZLE_LAB_RCKANGAROO_REPO when github is unreachable directly.
# BTC_PUZZLE_LAB_KEYHUNT_REPO= / _COMMIT=
# BTC_PUZZLE_LAB_KANGAROO_REPO= / _COMMIT=
# BTC_PUZZLE_LAB_BITCRACK_REPO= / _COMMIT=
# BTC_PUZZLE_LAB_RCKANGAROO_REPO= / _COMMIT=
# CUDA_HOME=/usr/local/cuda          # only when the toolkit is not autodetected

# Skip the "has this prize already been swept?" lookup before searching an
# unsolved target. For offline testing — a live hunt wants the check.
# BTC_PUZZLE_LAB_SKIP_PRIZE_CHECK=false

# --- Hit notifications (off by default; never include private keys) ---
NOTIFY_ENABLED=false
# Generic HTTPS webhook (Discord / Slack / ntfy / custom):
# NOTIFY_WEBHOOK_URL=https://example.com/hook
# Telegram bot (optional, can combine with webhook):
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=

# --- Control hub / sealed relay ---
# Hunt boxes often cannot reach Discord. They POST a sealed hit to the always-on
# control VPS, which unseals locally, notifies, and sweeps. Never plaintext keys.
#
# Control VPS (keep config/relay-secret here; do NOT set RELAY_URL):
#   btc-puzzle-lab relay-keygen
#   btc-puzzle-lab config --dest <addr> --notify https://discord... --new-relay-token
#   btc-puzzle-lab hub --host 0.0.0.0 --port 8787
#
# Hunt VPS (pubkey + token only; dest/sweep stay on the hub):
# RELAY_URL=https://<control-vps>:8787/hit
# RELAY_SEAL_PUBKEY=
# RELAY_TOKEN=

# The hub reads its seal secret from config/relay-secret (mode 0600), written by
# relay-keygen. RELAY_SEAL_SECRET overrides that file when it is set — for a hub
# whose secret comes from a secret manager rather than disk. Never set it on a
# hunt box: the whole point is that hunt boxes cannot unseal.
# RELAY_SEAL_SECRET=
